namespace StudentManagement
{
    public class Student
    {
        [RegularExpression(
            @"^SV\d{6}$",
            ErrorMessage = "Mã SV gồm SV và 6 chữ số")]
        public string StudentId { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Major { get; set; } = "";
        public double Score { get; set; }
        public bool IsActive { get; set; }
        public Student() { }
        public Student(string studentId, string fullName, string email, string major, double score, bool isActive)
        {
            StudentId = studentId;
            FullName = fullName;
            Email = email;
            Major = major;
            Score = score;
            IsActive = isActive;
        }
        public override string ToString()
        {
            return $"[{StudentId}] {FullName} | {Major} | Score: {Score:F1} | Email: {Email} | Active: {IsActive}";
        }
    }
}

